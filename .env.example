# ================================================================
# SkillMatch AI Services - Centralized LLM & App Configuration
# ================================================================

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "groq", "mistral", "deepseek", "ollama", "custom"
LLM_PROVIDER=gemini

# Primary LLM API Key (Can be Gemini API Key, OpenAI Key, Groq Key, etc.)
LLM_API_KEY=

# LLM Model Name (e.g. gemini-3.6-flash, gpt-4o-mini, llama-3.1-70b-versatile, etc.)
LLM_MODEL_NAME=gemini-3.6-flash

# Custom Base URL (Optional - for OpenAI-compatible proxies, Ollama http://localhost:11434/v1, vLLM, LiteLLM)
LLM_BASE_URL=

# Server & Pipeline Configuration
API_HOST=127.0.0.1
API_PORT=8001
ENVIRONMENT=development
TAXONOMY_PATH=docs/ai-contract/skills_seed.json
