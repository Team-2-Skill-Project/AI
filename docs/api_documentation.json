      "description": "Upload a digital CV/Resume file (PDF, DOCX, TXT, MD) up to 10MB. Synchronously extracts a normalized candidate profile containing contact info, skills, work experience, education, and projects.",
      "content_type": "multipart/form-data",
      "request_form_fields": {
        "file": "(binary CV file stream: pdf/docx/txt)",
        "candidate_id": "cand_12345 (optional)"
      },
      "request_body_json": null,
      "response_body_json": {
